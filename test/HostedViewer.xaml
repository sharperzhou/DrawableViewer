<Window x:Class="DrawableViewer.Test.HostedViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:dv="http://shaprer.gstarcad.extensions/xaml"
        xmlns:local="clr-namespace:DrawableViewer.Test"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance local:HostedViewerViewModel}"
        Title="HostedViewer" Height="450" Width="800">
    <Grid ShowGridLines="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <dv:DrawableViewerHost x:Name="SourceViewer" Source="{Binding Source}" Margin="5" />
            <StackPanel Grid.Column="1">
                <Button Content="独立圆" Command="{Binding DrawCircleCommand}" Margin="5" />
                <Button Content="当前空间" Command="{Binding DrawCurrentSpaceCommand}" Margin="5" />
                <Button Content="外部文件" Command="{Binding DrawExternalDwgCommand}" Margin="5" />
                <Button Content="清空" Command="{Binding ClearCommand}" Margin="5" />
            </StackPanel>
        </Grid>
        <dv:DrawableViewerHost x:Name="AnotherViewer" Grid.Column="1"
                               Source="{Binding ElementName=SourceViewer, Path=Database}" Margin="5" />
    </Grid>
</Window>